<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox alignment="CENTER" prefWidth="1800.0" spacing="10.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moinex.ui.dialog.creditcard.RecurringCreditCardDebtsController">
   <children>
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="5.0" HBox.hgrow="ALWAYS">
               <children>
                  <FontIcon iconLiteral="mdmz-search" styleClass="app-icon, icon-size-20" />
                  <TextField fx:id="searchField" promptText="%creditCard.recurring.searchPlaceholder" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <ComboBox fx:id="statusComboBox" minWidth="150.0" />
         </children>
      </HBox>
      <TableView fx:id="recurringDebtsTableView" maxHeight="350.0" minWidth="800.0">
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Button minWidth="90.0" onAction="#handleClose" text="%dialog.button.close" />
            
            
            <Button minWidth="90.0" onAction="#handleCreate" text="%dialog.button.create" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
