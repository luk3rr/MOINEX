<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.SegmentedControl?>
<?import javafx.geometry.Insets?>
<?import org.moinex.common.ui.TitledValue?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="640.0" minWidth="900.0" prefHeight="640.0" prefWidth="900.0" stylesheets="@../../../../css/component/anchor-pane.css, @../../../../css/scene/ticker-detail.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moinex.ui.dialog.investment.view.TickerDetailController">
   <children>
      <VBox spacing="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label fx:id="nameLabel" text="-">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="priceLabel" text="-">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Label>
                  <Label fx:id="dayChangeLabel" text="" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="30.0">
               <children>
                  <TitledValue fx:id="quantityLabel" />
                  <TitledValue fx:id="averagePriceLabel" />
                  <TitledValue fx:id="returnLabel" />
                  <Region HBox.hgrow="ALWAYS" />
                  <SegmentedControl fx:id="periodSegment" styleClass="filter-segment" />
               </children>
            </HBox>
            <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
               <VBox.margin>
                  <Insets top="12.0" />
               </VBox.margin>
               <tabs>
                  <Tab text="%tickerDetail.tab.price">
                     <content>
                        <VBox spacing="10.0">
                           <children>
                              <HBox fx:id="positionBox" alignment="CENTER_LEFT" spacing="25.0" />
                              <StackPane fx:id="chartHolder" minHeight="260.0" VBox.vgrow="ALWAYS" />
                              <TableView fx:id="tradesTable" maxHeight="150.0" minHeight="110.0" prefHeight="130.0">
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                           </children>
                           <padding>
                              <Insets top="10.0" />
                           </padding>
                        </VBox>
                     </content>
                  </Tab>
                  <Tab fx:id="incomeTab" text="%tickerDetail.tab.income">
                     <content>
                        <VBox spacing="10.0">
                           <children>
                              <HBox fx:id="incomeSummaryBox" alignment="CENTER_LEFT" spacing="30.0" />
                              <StackPane fx:id="incomeChartHolder" minHeight="260.0" VBox.vgrow="ALWAYS" />
                           </children>
                           <padding>
                              <Insets top="10.0" />
                           </padding>
                        </VBox>
                     </content>
                  </Tab>
               </tabs>
            </TabPane>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button fx:id="fundamentalButton" onAction="#handleFundamentalAnalysis" text="%savings.stocksFunds.button.fundamentalAnalysis" />
                  <Button onAction="#handleClose" text="%tickerDetail.close" />
               </children>
               <padding>
                  <Insets top="5.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
