<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="440.0" minWidth="760.0" prefHeight="460.0" prefWidth="780.0" stylesheets="@../../../../css/component/anchor-pane.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moinex.ui.dialog.investment.view.RebalanceController">
   <children>
      <VBox spacing="12.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="%savings.rebalance.contribution" />
                  <TextField fx:id="contributionField" prefWidth="160.0" promptText="0,00" />
               </children>
            </HBox>
            <TableView fx:id="rebalanceTable" VBox.vgrow="ALWAYS">
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <Label text="%savings.rebalance.note" wrapText="true" />
            <HBox alignment="CENTER">
               <children>
                  <Button onAction="#handleClose" text="%savings.rebalance.close" />
               </children>
               <padding>
                  <Insets top="4.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
