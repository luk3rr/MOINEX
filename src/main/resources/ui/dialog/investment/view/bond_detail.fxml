<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.SegmentedControl?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox minWidth="980.0" prefWidth="980.0" spacing="12.0" stylesheets="@../../../../css/component/bond-detail.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moinex.ui.dialog.investment.view.BondDetailController">
   <padding>
      <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <VBox spacing="2.0">
               <children>
                  <Label fx:id="titleLabel" wrapText="true">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <Label fx:id="subtitleLabel" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button minWidth="100.0" onAction="#handleBuy" text="%savings.bonds.button.buyBond" />
            <Button minWidth="100.0" onAction="#handleSell" text="%savings.bonds.button.sellBond" />
            <Button minWidth="100.0" onAction="#handleEdit" text="%savings.bonds.button.edit" />
         </children>
      </HBox>
      <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
         <tabs>
            <Tab text="%bond.detail.tab.overview">
               <content>
                  <VBox spacing="14.0">
                     <padding>
                        <Insets top="12.0" />
                     </padding>
                     <children>
      <VBox spacing="6.0">
         <children>
            <Label styleClass="bond-detail-section" text="%bond.detail.section.data" />
            <HBox fx:id="dataPane" spacing="12.0" />
         </children>
      </VBox>
      <VBox spacing="6.0">
         <children>
            <Label styleClass="bond-detail-section" text="%bond.detail.section.position" />
            <HBox fx:id="positionPane" spacing="12.0" />
         </children>
      </VBox>
      <VBox spacing="6.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label styleClass="bond-detail-section" text="%bond.detail.balance.heading" />
                  <Region HBox.hgrow="ALWAYS" />
                  <SegmentedControl fx:id="balancePeriodSegment" />
               </children>
            </HBox>
            <StackPane fx:id="balanceHolder" minHeight="220.0" prefHeight="220.0" />
         </children>
      </VBox>
                     </children>
                  </VBox>
               </content>
            </Tab>
            <Tab text="%bond.detail.tab.tables">
               <content>
                  <VBox spacing="6.0">
                     <padding>
                        <Insets top="12.0" />
                     </padding>
                     <children>
                  <HBox alignment="CENTER_RIGHT" spacing="8.0">
               <children>
                  <ComboBox fx:id="yearComboBox" minWidth="150.0" />
               </children>
            </HBox>
            <TabPane fx:id="tabs" minHeight="240.0" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
               <tabs>
                  <Tab fx:id="historyTab" text="%bond.detail.tab.history" />
                  <Tab fx:id="operationsTab" text="%bond.detail.tab.operations" />
               </tabs>
            </TabPane>
                     </children>
                  </VBox>
               </content>
            </Tab>
         </tabs>
      </TabPane>
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Button minWidth="110.0" onAction="#handleClose" text="%dialog.button.close" />
            <Button fx:id="archiveButton" minWidth="110.0" onAction="#handleArchive" text="%bond.detail.archive" />
         </children>
      </HBox>
   </children>
</VBox>
