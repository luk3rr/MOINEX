<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moinex.ui.dialog.investment.view.InvestmentTransactionsController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="5.0">
         <children>
            <FontIcon iconLiteral="mdmz-search" styleClass="app-icon, icon-size-20" />
            <TextField fx:id="searchField" promptText="%investment.promptText.searchIdOrDescription" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <Label text="%investment.label.selectTransaction" />
      <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
          <Tab closable="false" text="%investment.tab.purchase">
            <content>
              <AnchorPane>
                     <children>
                        <TableView fx:id="purchaseTableView" minWidth="1200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy></TableView>
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
            <Tab closable="false" text="%investment.tab.sale">
               <content>
                  <AnchorPane>
                     <children>
                        <TableView fx:id="saleTableView" minWidth="1200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy></TableView>
                     </children>
                  </AnchorPane>
               </content>
            </Tab>
          <Tab closable="false" text="%investment.tab.dividend">
            <content>
              <AnchorPane>
                     <children>
                        <TableView fx:id="dividendTableView" minWidth="1200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy></TableView>
                     </children>
                  </AnchorPane>
            </content>
          </Tab>
            <Tab closable="false" text="%investment.tab.cryptoExchange">
               <content>
                  <AnchorPane>
                     <children>
                        <TableView fx:id="cryptoExchangeTableView" minWidth="1200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                  </AnchorPane>
               </content>
            </Tab>
        </tabs>
      </TabPane>

      <HBox alignment="CENTER" spacing="10.0" VBox.vgrow="ALWAYS">
         <children>
            <Button minWidth="110.0" onAction="#handleCancel" text="%dialog.button.cancel" />
            
            
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
