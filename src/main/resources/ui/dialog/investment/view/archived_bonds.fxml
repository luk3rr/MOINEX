<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moinex.ui.dialog.investment.view.ArchivedBondsController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="5.0">
         <children>
            <FontIcon iconLiteral="mdmz-search" styleClass="app-icon, icon-size-20" />
            <TextField fx:id="searchField" promptText="%bond.promptText.searchIdOrDescription" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <Label text="%bond.label.selectBond" />
      <TableView fx:id="bondTableView" minWidth="1200.0">
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>

      <HBox alignment="CENTER" spacing="10.0" VBox.vgrow="ALWAYS">
         <children>
            <Button minWidth="110.0" onAction="#handleCancel" text="%dialog.button.cancel" />
            <Button minWidth="110.0" onAction="#handleDelete" text="%dialog.button.delete" />
            <Button minWidth="110.0" onAction="#handleUnarchive" text="%dialog.button.unarchive" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
