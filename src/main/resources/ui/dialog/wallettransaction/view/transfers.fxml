<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox alignment="CENTER" prefWidth="1400.0" spacing="10.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moinex.ui.dialog.wallettransaction.view.TransferController">
   <children>
      <VBox alignment="CENTER_RIGHT" spacing="10.0" VBox.vgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER_RIGHT">
               <children>
                  <HBox alignment="CENTER_RIGHT" spacing="10.0">
                     <children>
                        <VBox alignment="CENTER">
                           <children>
                              <Label text="%wallettransaction.label.startDate">
                                 <font>
                                    <Font size="10.0" />
                                 </font>
                              </Label>
                              <DatePicker fx:id="transfersStartDatePicker" maxWidth="150.0" />
                           </children>
                        </VBox>
                        <VBox alignment="CENTER">
                           <children>
                              <Label text="%wallettransaction.label.endDate">
                                 <font>
                                    <Font size="10.0" />
                                 </font>
                              </Label>
                              <DatePicker fx:id="transfersEndDatePicker" maxWidth="150.0" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </HBox>
            <HBox alignment="CENTER_RIGHT" spacing="5.0">
               <children>
                  <FontIcon iconLiteral="mdmz-search" styleClass="app-icon, icon-size-20" />
                  <TextField fx:id="searchField" promptText="%wallettransaction.prompt.enterIdOrDescription" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
         </children>
      </VBox>
      <TableView fx:id="transfersTableView" maxHeight="300.0" minWidth="600.0">
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>

      <HBox alignment="CENTER" spacing="10.0" VBox.vgrow="ALWAYS">
         <children>
            <Button minWidth="90.0" onAction="#handleCancel" text="%dialog.button.cancel" />
            
            
            <Button minWidth="90.0" onAction="#handleAdd" text="%dialog.button.add" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
