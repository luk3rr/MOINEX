<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox alignment="CENTER" prefWidth="1800.0" spacing="10.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moinex.ui.dialog.wallettransaction.view.RecurringTransactionController">
   <children>
      <VBox alignment="CENTER_RIGHT" spacing="10.0" VBox.vgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER_RIGHT">
               <children>
                  <VBox alignment="CENTER">
                     <children>
                        <Label text="%dialog.label.status">
                           <font>
                              <Font size="10.0" />
                           </font>
                        </Label>
                        <ComboBox fx:id="statusComboBox" minWidth="150.0" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <HBox alignment="CENTER_RIGHT" spacing="5.0">
               <children>
                  <FontIcon iconLiteral="mdmz-search" styleClass="app-icon, icon-size-20" />
                  <TextField fx:id="searchField" promptText="%wallettransaction.prompt.enterIdOrDescription" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
         </children>
      </VBox>
      <TableView fx:id="recurringTransactionTableView" maxHeight="300.0" minWidth="600.0">
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>

      <HBox alignment="CENTER" spacing="10.0" VBox.vgrow="ALWAYS">
         <children>
            <Button minWidth="90.0" onAction="#handleCancel" text="%dialog.button.cancel" />
            <Button minWidth="90.0" onAction="#handleDelete" text="%dialog.button.delete" />
            <Button minWidth="90.0" onAction="#handleEdit" text="%dialog.button.edit" />
            <Button minWidth="90.0" onAction="#handleCreate" text="%dialog.button.create" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
