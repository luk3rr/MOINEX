<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moinex.ui.common.CalendarController">
   <VBox alignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
      <children>
         <GridPane fx:id="calendar" alignment="CENTER" gridLinesVisible="true" minHeight="600.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
           <columnConstraints>
               <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
             <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
             <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
           </columnConstraints>
           <rowConstraints>
               <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
             <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
             <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
             <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
           </rowConstraints>
         </GridPane>
         <HBox alignment="CENTER" prefHeight="44.0" prefWidth="419.0" spacing="5.0">
            <children>
               <Button onAction="#handleBackOneMonth">
                  <graphic>
                     <FontIcon iconLiteral="mdal-arrow_back" styleClass="app-icon, icon-size-20" />
                  </graphic>
               </Button>
               <Region prefWidth="20.0" />
               <Label fx:id="currentMonth" text="MM/YY">
                  <font>
                     <Font name="System Bold" size="15.0" />
                  </font>
               </Label>
               <Region prefWidth="20.0" />
               <Button onAction="#handleForwardOneMonth">
                  <graphic>
                     <FontIcon iconLiteral="mdal-arrow_forward" styleClass="app-icon, icon-size-20" />
                  </graphic>
               </Button>
            </children>
         </HBox>
         <HBox alignment="CENTER" prefHeight="44.0" prefWidth="419.0" spacing="5.0">
            <children>
               <Button onAction="#handleAddEvent" text="%common.calendar.addEvent">
                  <graphic>
                     <FontIcon iconLiteral="mdal-add" styleClass="app-icon, icon-size-20" />
                  </graphic>
               </Button>
            </children>
         </HBox>
      </children>
      <padding>
         <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
      </padding>
   </VBox>
   <stylesheets>
      <URL value="@../css/common/common-styles.css" />
      <URL value="@../css/component/anchor-pane.css" />
   </stylesheets>

</AnchorPane>
