<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane fx:id="rootPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="768.0" minWidth="1450.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moinex.ui.main.MainController">
   <children>
      <HBox fx:id="rootHBox" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <VBox fx:id="sidebar" spacing="20.0" HBox.hgrow="NEVER">
               <children>
                  <Button fx:id="menuButton" alignment="BASELINE_LEFT" contentDisplay="GRAPHIC_ONLY" graphicTextGap="15.0" text="%main.menu" wrapText="true">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                     <graphic>
                        <FontIcon iconLiteral="mdmz-menu" styleClass="app-icon, icon-size-30" />
                     </graphic>
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets>
                  </Button>
                  <Button fx:id="homeButton" alignment="BASELINE_LEFT" contentDisplay="GRAPHIC_ONLY" graphicTextGap="15.0" text="%main.home" wrapText="true">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                     <graphic>
                        <FontIcon iconLiteral="mdal-home" styleClass="app-icon, icon-size-35" />
                     </graphic>
                     <VBox.margin>
                        <Insets top="40.0" />
                     </VBox.margin>
                  </Button>
                  <Button fx:id="walletButton" alignment="BASELINE_LEFT" contentDisplay="GRAPHIC_ONLY" graphicTextGap="15.0" text="%main.wallet" wrapText="true">
                     <graphic>
                        <FontIcon iconLiteral="mdal-account_balance_wallet" styleClass="app-icon, icon-size-35" />
                     </graphic>
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
                  <Button fx:id="creditCardButton" alignment="BASELINE_LEFT" contentDisplay="GRAPHIC_ONLY" graphicTextGap="15.0" text="%main.creditCard" wrapText="true">
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets>
                     <graphic>
                        <FontIcon iconLiteral="mdal-credit_card" styleClass="app-icon, icon-size-35" />
                     </graphic>
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
                  <Button fx:id="transactionButton" alignment="BASELINE_LEFT" contentDisplay="GRAPHIC_ONLY" graphicTextGap="15.0" text="%main.transaction" wrapText="true">
                     <graphic>
                        <FontIcon iconLiteral="mdmz-receipt" styleClass="app-icon, icon-size-35" />
                     </graphic>
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
                  <Button fx:id="goalsAndPlanButton" alignment="BASELINE_LEFT" contentDisplay="GRAPHIC_ONLY" graphicTextGap="15.0" text="%main.goalsAndPlans" wrapText="true">
                     <graphic>
                        <FontIcon iconLiteral="mdal-flag" styleClass="app-icon, icon-size-35" />
                     </graphic>
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
                  <Button fx:id="savingsButton" alignment="BASELINE_LEFT" contentDisplay="GRAPHIC_ONLY" graphicTextGap="15.0" text="%main.savings" wrapText="true">
                     <graphic>
                        <ImageView fitHeight="35.0" fitWidth="35.0" pickOnBounds="true" preserveRatio="true" styleClass="colored-icon">
                           <image>
                              <Image url="@../../icon/sidebar/savings.png" />
                           </image>
                        </ImageView>
                     </graphic>
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
                  <Button fx:id="annualSummaryButton" alignment="BASELINE_LEFT" contentDisplay="GRAPHIC_ONLY" graphicTextGap="15.0" text="%main.annualSummary" wrapText="true">
                     <graphic>
                        <FontIcon iconLiteral="mdal-bar_chart" styleClass="app-icon, icon-size-35" />
                     </graphic>
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
                  <Button fx:id="aiChatButton" alignment="BASELINE_LEFT" contentDisplay="GRAPHIC_ONLY" graphicTextGap="15.0" text="%main.aiChat" wrapText="true">
                     <graphic>
                        <FontIcon iconLiteral="mdal-chat" styleClass="app-icon, icon-size-35" />
                     </graphic>
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Button>
                  <VBox alignment="BOTTOM_LEFT" spacing="20.0" VBox.vgrow="ALWAYS">
                     <children>
                        <Button fx:id="settingsButton" alignment="BASELINE_LEFT" contentDisplay="GRAPHIC_ONLY" graphicTextGap="15.0" onAction="#handleOpenSettings" text="%main.settings" wrapText="true">
                           <graphic>
                              <FontIcon iconLiteral="mdmz-settings" styleClass="app-icon, icon-size-35" />
                           </graphic>
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                           <VBox.margin>
                              <Insets bottom="20.0" />
                           </VBox.margin>
                        </Button>
                     </children>
                  </VBox>
               </children>
            </VBox>
            <VBox HBox.hgrow="ALWAYS">
               <children>
                     <AnchorPane fx:id="contentArea" VBox.vgrow="ALWAYS" />
                  <HBox fx:id="footbarArea" alignment="CENTER_RIGHT" minHeight="32.0" prefHeight="32.0" spacing="10.0">
                     <VBox.margin>
                        <Insets bottom="4.0" />
                     </VBox.margin>
                     <children>
                        <Label fx:id="versionLabel" styleClass="footer-version" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleOpenSearch" styleClass="search-hint-button" text="%main.search.hint">
                           <font>
                              <Font size="9.0" />
                           </font>
                           <graphic>
                              <FontIcon iconLiteral="mdmz-search" styleClass="app-icon, icon-size-15" />
                           </graphic>
                        </Button>
                        <Button onAction="#handleOpenCalendar" text="%main.calendar">
                           <font>
                              <Font size="9.0" />
                           </font>
                           <graphic>
                              <FontIcon iconLiteral="mdal-calendar_today" styleClass="app-icon, icon-size-15" />
                           </graphic>
                        </Button>
                        <Button onAction="#handleOpenCalculator" text="%main.calculator">
                           <font>
                              <Font size="9.0" />
                           </font>
                           <graphic>
                              <FontIcon iconLiteral="mdal-calculate" styleClass="app-icon, icon-size-15" />
                           </graphic>
                        </Button>
                        <Button fx:id="notificationsButton" onAction="#handleToggleNotifications" text="%main.notifications">
                           <font>
                              <Font size="9.0" />
                           </font>
                           <graphic>
                              <StackPane>
                                 <FontIcon fx:id="bellIcon" iconLiteral="mdmz-notifications" styleClass="app-icon, icon-size-15" />
                                 <Label fx:id="unreadBadge" styleClass="notification-badge" text="0" visible="false" StackPane.alignment="TOP_RIGHT" />
                              </StackPane>
                           </graphic>
                        </Button>
                        <Button onAction="#handleToggleMonetaryValues">
                           <font>
                              <Font size="9.0" />
                           </font>
                           <graphic>
                              <FontIcon fx:id="toggleMonetaryValuesIcon" iconLiteral="mdmz-visibility_off" styleClass="app-icon, icon-size-15" />
                           </graphic>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>
      <Button fx:id="screenActionsButton" styleClass="floating-action-button" AnchorPane.bottomAnchor="64.0" AnchorPane.rightAnchor="24.0">
         <graphic>
            <FontIcon iconLiteral="mdal-add" styleClass="app-icon, icon-size-24" />
         </graphic>
      </Button>
   </children>
</AnchorPane>
