<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moinex.ui.main.TransactionController">
   <children>
      <VBox spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <AnchorPane minHeight="300.0">
               <children>
                  <HBox layoutX="89.0" layoutY="40.0" minHeight="300.0" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <children>
                        <VBox alignment="CENTER" spacing="10.0">
                           <children>
                              <HBox spacing="10.0" VBox.vgrow="ALWAYS">
                                 <children>
                                    <AnchorPane fx:id="monthYearResumePane" styleClass="anchor-pane" stylesheets="@../../css/component/anchor-pane.css" HBox.hgrow="ALWAYS">
                                       <children>
                                          <VBox alignment="TOP_CENTER" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                             <children>
                                                <HBox alignment="CENTER">
                                                   <children>
                                                      <Label fx:id="monthYearResumeTitle" styleClass="title" text="%transaction.monthlyResume.title" HBox.hgrow="ALWAYS" />
                                                      <AnchorPane HBox.hgrow="ALWAYS">
                                                         <children>
                                                            <HBox alignment="CENTER_RIGHT" spacing="5.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                                               <children>
                                                                  <ComboBox fx:id="monthYearResumeMonthComboBox" minWidth="90.0" />
                                                                  <ComboBox fx:id="monthYearResumeYearComboBox" minWidth="90.0" />
                                                               </children>
                                                            </HBox>
                                                         </children>
                                                      </AnchorPane>
                                                   </children>
                                                </HBox>
                                                <AnchorPane fx:id="monthYearResumeView" minWidth="200.0" VBox.vgrow="ALWAYS" />
                                             </children>
                                          </VBox>
                                       </children>
                                    </AnchorPane>
                                    <AnchorPane styleClass="anchor-pane" stylesheets="@../../css/component/anchor-pane.css" HBox.hgrow="ALWAYS">
                                       <children>
                                          <VBox alignment="TOP_CENTER" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                             <children>
                                                <HBox alignment="CENTER">
                                                   <children>
                                                      <Label styleClass="title" text="%transaction.yearlyResume.title" HBox.hgrow="ALWAYS" />
                                                      <AnchorPane HBox.hgrow="ALWAYS">
                                                         <children>
                                                            <ComboBox fx:id="yearResumeComboBox" minWidth="90.0" AnchorPane.rightAnchor="0.0" />
                                                         </children>
                                                      </AnchorPane>
                                                   </children>
                                                </HBox>
                                                <AnchorPane fx:id="yearResumeView" minWidth="200.0" VBox.vgrow="ALWAYS" />
                                             </children>
                                          </VBox>
                                       </children>
                                    </AnchorPane>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                        <AnchorPane fx:id="barchartPane" styleClass="anchor-pane" stylesheets="@../../css/component/anchor-pane.css" HBox.hgrow="ALWAYS">
                           <children>
                              <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                 <children>
                                    <HBox alignment="CENTER">
                                       <children>
                                          <Label fx:id="moneyFlowTitle" styleClass="title" text="%transaction.moneyFlowByCategory.title" HBox.hgrow="ALWAYS" />
                                          <AnchorPane HBox.hgrow="ALWAYS">
                                             <children>
                                                <ComboBox fx:id="moneyFlowComboBox" minWidth="150.0" AnchorPane.rightAnchor="0.0" />
                                             </children>
                                          </AnchorPane>
                                       </children>
                                    </HBox>
                                    <AnchorPane fx:id="moneyFlowView" VBox.vgrow="ALWAYS" />
                                 </children>
                              </VBox>
                           </children>
                        </AnchorPane>
                     </children>
                  </HBox>
               </children>
            </AnchorPane>
            <AnchorPane minHeight="350.0" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <children>
                        <AnchorPane fx:id="transactionsPane" styleClass="anchor-pane" stylesheets="@../../css/component/anchor-pane.css" HBox.hgrow="ALWAYS">
                           <children>
                              <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                 <children>
                                    <VBox spacing="10.0">
                                       <children>
                                          <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                                             <children>
                                                <Label fx:id="transactionsPaneTitle" styleClass="title" text="%transaction.transactionList.title" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                            <HBox fx:id="transactionsFilterGroup" alignment="BOTTOM_RIGHT" spacing="10.0">
                                                               <children>
                                                                  <VBox alignment="CENTER">
                                                                     <children>
                                                                        <Label text="%transaction.transactionList.type">
                                                                           <font>
                                                                              <Font size="10.0" />
                                                                           </font>
                                                                        </Label>
                                                                        <ComboBox fx:id="transactionsTypeComboBox" minWidth="150.0" />
                                                                     </children>
                                                                  </VBox>
                                                                  <VBox alignment="CENTER">
                                                                     <children>
                                                                        <Label text="%transaction.transactionList.startDate">
                                                                           <font>
                                                                              <Font size="10.0" />
                                                                           </font>
                                                                        </Label>
                                                                        <DatePicker fx:id="transactionsStartDatePicker" maxWidth="150.0" />
                                                                     </children>
                                                                  </VBox>
                                                                  <VBox alignment="CENTER">
                                                                     <children>
                                                                        <Label text="%transaction.transactionList.endDate">
                                                                           <font>
                                                                              <Font size="10.0" />
                                                                           </font>
                                                                        </Label>
                                                                        <DatePicker fx:id="transactionsEndDatePicker" maxWidth="150.0" />
                                                                     </children>
                                                                  </VBox>
                                                               </children>
                                                            </HBox>
                                             </children>
                                          </HBox>
                                          <HBox alignment="CENTER_RIGHT" spacing="5.0">
                                             <children>
                                                            <FontIcon iconLiteral="mdmz-search" styleClass="app-icon, icon-size-20" />
                                                            <TextField fx:id="transactionsSearchField" promptText="%transaction.transactionList.searchPlaceholder" HBox.hgrow="ALWAYS" />
                                             </children>
                                          </HBox>
                                       </children>
                                    </VBox>
                                    <TableView fx:id="transactionsTableView" VBox.vgrow="ALWAYS">
                                       <columnResizePolicy>
                                          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                       </columnResizePolicy>
                                    </TableView>
                                 </children>
                              </VBox>
                           </children>
                        </AnchorPane>
                     </children>
                  </HBox>
               </children>
            </AnchorPane>
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</AnchorPane>
