<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moinex.ui.main.SavingsBondsController">
   <children>
      <VBox spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <AnchorPane minHeight="85.0" prefHeight="85.0" styleClass="anchor-pane" stylesheets="@../../css/component/anchor-pane.css" VBox.vgrow="NEVER">
               <children>
                  <HBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <children>
                        <VBox alignment="CENTER" spacing="10.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Text fx:id="bondsTotalInvestedLabel" strokeType="OUTSIDE" strokeWidth="0.0" text="%savings.bonds.totalInvested" textAlignment="CENTER">
                                 <font>
                                    <Font size="20.0" />
                                 </font>
                              </Text>
                              <Text fx:id="bondsTabTotalInvestedField" strokeType="OUTSIDE" strokeWidth="0.0" text="\$ 0.00">
                                 <font>
                                    <Font size="17.0" />
                                 </font>
                              </Text>
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" spacing="10.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Text fx:id="bondsCurrentValueLabel" strokeType="OUTSIDE" strokeWidth="0.0" text="%savings.bonds.currentValue" textAlignment="CENTER">
                                 <font>
                                    <Font size="20.0" />
                                 </font>
                              </Text>
                              <Text fx:id="bondsTabCurrentValueField" strokeType="OUTSIDE" strokeWidth="0.0" text="\$ 0.00">
                                 <font>
                                    <Font size="17.0" />
                                 </font>
                              </Text>
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" spacing="10.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Text fx:id="bondsProfitLossLabel" strokeType="OUTSIDE" strokeWidth="0.0" text="%savings.bonds.profitLoss" textAlignment="CENTER">
                                 <font>
                                    <Font size="20.0" />
                                 </font>
                              </Text>
                              <Text fx:id="bondsTabProfitLossField" strokeType="OUTSIDE" strokeWidth="0.0" text="\$ 0.00">
                                 <font>
                                    <Font size="17.0" />
                                 </font>
                              </Text>
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" spacing="10.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Text fx:id="bondsInterestReceivedLabel" strokeType="OUTSIDE" strokeWidth="0.0" text="%savings.bonds.interestReceived" textAlignment="CENTER">
                                 <font>
                                    <Font size="20.0" />
                                 </font>
                              </Text>
                              <Text fx:id="bondsTabInterestReceivedField" strokeType="OUTSIDE" strokeWidth="0.0" text="\$ 0.00">
                                 <font>
                                    <Font size="17.0" />
                                 </font>
                              </Text>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </AnchorPane>
            <AnchorPane minHeight="45.0" prefHeight="45.0" styleClass="anchor-pane" stylesheets="@../../css/component/anchor-pane.css" VBox.vgrow="NEVER">
               <children>
                  <HBox alignment="CENTER" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <children>
                        <Button onAction="#handleRegisterBond" text="%savings.bonds.button.registerBond">
                           <graphic>
                              <FontIcon iconLiteral="mdal-add" styleClass="app-icon, icon-size-20" />
                           </graphic>
                        </Button>
                        <Button onAction="#handleOpenBondArchive" text="%savings.bonds.button.bondArchive">
                           <graphic>
                              <FontIcon iconLiteral="mdal-archive" styleClass="app-icon, icon-size-20" />
                           </graphic>
                        </Button>
                        <Button onAction="#handleShowBondTransactions" text="%savings.bonds.button.showTransactions">
                           <graphic>
                              <FontIcon iconLiteral="mdal-list" styleClass="app-icon, icon-size-20" />
                           </graphic>
                        </Button>
                        <Region HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
               </children>
            </AnchorPane>
            <AnchorPane styleClass="anchor-pane" stylesheets="@../../css/component/anchor-pane.css" VBox.vgrow="ALWAYS">
               <children>
                  <VBox spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <children>
                        <HBox spacing="10.0">
                           <children>
                              <VBox HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label fx:id="bondsTabBottonPaneTitle" styleClass="title" text="%savings.bonds.portfolio" />
                                    <AnchorPane VBox.vgrow="ALWAYS">
                                       <children>
                                          <HBox spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                                             <children>
                                                <Button onAction="#handleEditBond" text="%savings.bonds.button.edit">
                                                   <graphic>
                                                      <FontIcon iconLiteral="mdal-edit" styleClass="app-icon, icon-size-20" />
                                                   </graphic>
                                                </Button>
                                                <Button onAction="#handleDeleteBond" text="%savings.bonds.button.delete">
                                                   <graphic>
                                                      <FontIcon iconLiteral="mdal-close" styleClass="app-icon, icon-size-20" />
                                                   </graphic>
                                                </Button>
                                                <Button onAction="#handleBuyBond" text="%savings.bonds.button.buyBond">
                                                   <graphic>
                                                      <FontIcon iconLiteral="mdal-login" styleClass="app-icon, icon-size-20" />
                                                   </graphic>
                                                </Button>
                                                <Button onAction="#handleSellBond" text="%savings.bonds.button.sellBond">
                                                   <graphic>
                                                      <FontIcon iconLiteral="mdal-exit_to_app" styleClass="app-icon, icon-size-20" />
                                                   </graphic>
                                                </Button>
                                                <Button onAction="#handleShowInterestHistory" text="%savings.bonds.button.interestHistory">
                                                   <graphic>
                                                      <FontIcon iconLiteral="mdal-list" styleClass="app-icon, icon-size-20" />
                                                   </graphic>
                                                </Button>
                                             </children>
                                          </HBox>
                                       </children>
                                    </AnchorPane>
                                 </children>
                              </VBox>
                              <VBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                       <children>
                                          <VBox alignment="CENTER">
                                             <children>
                                                <Label text="%savings.bonds.filter.type">
                                                   <font>
                                                      <Font size="10.0" />
                                                   </font>
                                                </Label>
                                                <ComboBox fx:id="bondsTabBondTypeComboBox" minWidth="150.0" />
                                             </children>
                                          </VBox>
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="5.0" VBox.vgrow="ALWAYS">
                                       <children>
                                          <FontIcon iconLiteral="mdmz-search" styleClass="app-icon, icon-size-20" />
                                          <TextField fx:id="bondsTabBondSearchField" prefWidth="300.0" promptText="%savings.bonds.searchPlaceholder" HBox.hgrow="ALWAYS" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <TableView fx:id="bondsTabBondTable" VBox.vgrow="ALWAYS">
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </AnchorPane>
         </children>
         <padding>
            <Insets top="10.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
