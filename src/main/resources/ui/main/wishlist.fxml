<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.SegmentedControl?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane stylesheets="@../../css/component/charts.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moinex.ui.main.WishlistController">
   <children>
      <VBox spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox minHeight="300.0" spacing="10.0">
               <children>
                  <AnchorPane styleClass="anchor-pane" stylesheets="@../../css/component/anchor-pane.css">
                     <children>
                        <Label styleClass="title" text="%wishlist.chart.categoryDistribution.title" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="10.0" />
                        <AnchorPane fx:id="categoryChartPane" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="40.0" />
                     </children>
                  </AnchorPane>
                  <AnchorPane styleClass="anchor-pane" stylesheets="@../../css/component/anchor-pane.css" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="title" text="%wishlist.chart.monthlyTimeline.title" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="10.0" />
                        <AnchorPane fx:id="timelineChartPane" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="40.0" />
                     </children>
                  </AnchorPane>
               </children>
            </HBox>
            <AnchorPane styleClass="anchor-pane" stylesheets="@../../css/component/anchor-pane.css">
               <children>
                  <VBox spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <children>
                        <VBox spacing="10.0">
                           <children>
                              <HBox alignment="BOTTOM_LEFT" spacing="20.0">
                                 <children>
                                    <Label styleClass="title" text="%wishlist.title" />
                                    <Label fx:id="itemCountLabel" text="0 items">
                                       <font>
                                          <Font size="12.0" />
                                       </font>
                                    </Label>
                                    <Label fx:id="totalValueLabel" text="Total: $ 0.00">
                                       <font>
                                          <Font size="12.0" />
                                       </font>
                                    </Label>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <HBox fx:id="filterGroup" alignment="BOTTOM_LEFT" spacing="10.0">
                                       <children>
                                          <VBox spacing="4.0">
                                             <children>
                                           <Label text="%wishlist.filter.status">
                                              <font>
                                                 <Font size="10.0" />
                                              </font>
                                           </Label>
                                                <SegmentedControl fx:id="statusFilterControl" styleClass="filter-segment" />
                                             </children>
                                          </VBox>
                                          <VBox spacing="4.0">
                                             <children>
                                           <Label text="%wishlist.filter.category">
                                              <font>
                                                 <Font size="10.0" />
                                              </font>
                                           </Label>
                                                <ComboBox fx:id="categoryFilterComboBox" minWidth="140.0" prefHeight="34.0" styleClass="filter-control" />
                                             </children>
                                          </VBox>
                                       </children>
                                    </HBox>
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <HBox alignment="CENTER_LEFT" spacing="5.0">
                                       <children>
                                          <FontIcon iconLiteral="mdmz-search" styleClass="app-icon, icon-size-20" />
                                          <TextField fx:id="searchField" prefHeight="34.0" promptText="%wishlist.search.placeholder" />
                                       </children>
                                    </HBox>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                        <TableView fx:id="wishlistTableView" VBox.vgrow="ALWAYS">
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </AnchorPane>
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</AnchorPane>
