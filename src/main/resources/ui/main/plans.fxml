<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane stylesheets="@../../css/component/charts.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moinex.ui.main.PlanController">
   <children>
      <VBox spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Label styleClass="title" text="%plan.title">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <ComboBox fx:id="periodComboBox" minWidth="150.0" />
               </children>
            </HBox>
            <AnchorPane prefHeight="500.0">
               <children>
                  <HBox layoutX="89.0" layoutY="40.0" minHeight="300.0" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <children>
                        <VBox alignment="CENTER" spacing="10.0">
                           <children>
                              <AnchorPane maxWidth="450.0" minWidth="350.0" prefWidth="400.0" styleClass="anchor-pane" stylesheets="@../../css/component/anchor-pane.css" VBox.vgrow="ALWAYS">
                                 <children>
                                    <Label fx:id="planNameLabel" styleClass="title" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="10.0" />
                                    <Label fx:id="planPeriodLabel" layoutX="10.0" layoutY="10.0" style="-fx-font-style: italic; -fx-font-size: 10;" AnchorPane.leftAnchor="15.0" AnchorPane.topAnchor="40.0" />
                                    <VBox alignment="CENTER_LEFT" layoutX="5.0" layoutY="50.0" AnchorPane.bottomAnchor="60.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="60.0">
                                       <children>
                                          <Label text="%plan.baseMonthlyIncome">
                                             <font>
                                                <Font name="System Bold" size="18.0" />
                                             </font>
                                          </Label>
                                          <Label fx:id="baseMonthlyIncome" text="\$ 0.00">
                                             <font>
                                                <Font size="36.0" />
                                             </font>
                                          </Label>
                                       </children>
                                    </VBox>
                                 </children>
                              </AnchorPane>
                              <AnchorPane styleClass="anchor-pane" stylesheets="@../../css/component/anchor-pane.css">
                                 <children>
                                    <HBox alignment="CENTER" layoutX="-21.0" layoutY="25.0" spacing="5.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                       <children>
                                          <Button onAction="#handleNewPlan" text="%plan.button.newPlan">
                                             <graphic>
                                                <FontIcon iconLiteral="mdal-add" styleClass="app-icon, icon-size-16" />
                                             </graphic>
                                          </Button>
                                          <Button onAction="#handleEditPlan" text="%plan.button.editPlan">
                                             <graphic>
                                                <FontIcon iconLiteral="mdal-edit" styleClass="app-icon, icon-size-16" />
                                             </graphic>
                                          </Button>
                                       </children>
                                    </HBox>
                                 </children>
                              </AnchorPane>
                           </children>
                        </VBox>
                        <AnchorPane maxWidth="450.0" minWidth="350.0" prefWidth="400.0" styleClass="anchor-pane" stylesheets="@../../css/component/anchor-pane.css" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="title" text="%plan.planDistribution.title" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="10.0" />
                              <HBox prefHeight="100.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="60.0">
                                 <children>
                                    <AnchorPane fx:id="pieChartAnchorPane" minWidth="200.0" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                           </children>
                        </AnchorPane>
                        <AnchorPane minWidth="400.0" prefWidth="450.0" styleClass="anchor-pane" stylesheets="@../../css/component/anchor-pane.css" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="title" text="%plan.timeline.title" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="10.0" />
                              <AnchorPane fx:id="timelineChartAnchorPane" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="60.0" />
                           </children>
                        </AnchorPane>
                     </children>
                  </HBox>
               </children>
            </AnchorPane>
            <AnchorPane minHeight="350.0" prefHeight="350.0" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <children>
                        <AnchorPane styleClass="anchor-pane" stylesheets="@../../css/component/anchor-pane.css" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="title" text="%plan.budgetGroups.title" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="10.0" />
                              <Button fx:id="budgetGroupPrevButton" AnchorPane.bottomAnchor="10.0" AnchorPane.rightAnchor="60.0">
                                 <graphic>
                                    <FontIcon iconLiteral="mdal-arrow_back" styleClass="app-icon, icon-size-20" />
                                 </graphic>
                              </Button>
                              <Button fx:id="budgetGroupNextButton" AnchorPane.bottomAnchor="10.0" AnchorPane.rightAnchor="0.0">
                                 <graphic>
                                    <FontIcon iconLiteral="mdal-arrow_forward" styleClass="app-icon, icon-size-20" />
                                 </graphic>
                              </Button>
                              <HBox alignment="CENTER" spacing="10.0" AnchorPane.bottomAnchor="60.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="60.0">
                                 <children>
                                    <AnchorPane fx:id="budgetGroupPane1" minHeight="150.0" minWidth="200.0" HBox.hgrow="ALWAYS" />
                                    <AnchorPane fx:id="budgetGroupPane2" minHeight="150.0" minWidth="200.0" HBox.hgrow="ALWAYS" />
                                    <AnchorPane fx:id="budgetGroupPane3" minHeight="150.0" minWidth="200.0" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                           </children>
                        </AnchorPane>
                     </children>
                  </HBox>
               </children>
            </AnchorPane>
         </children>
         <padding>
            <Insets top="10.0" />
         </padding>
      </VBox>
   </children>
   <padding>
      <Insets bottom="4.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</AnchorPane>
