<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moinex.ui.main.CreditCardController">
   <children>
      <VBox spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <AnchorPane minHeight="300.0" VBox.vgrow="NEVER">
               <children>
                  <HBox layoutX="89.0" layoutY="40.0" minHeight="300.0" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <children>
                        <VBox alignment="CENTER" maxWidth="450.0" minWidth="350.0" prefWidth="400.0" spacing="10.0" HBox.hgrow="ALWAYS">
                           <children>
                              <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                                 <children>
                                    <AnchorPane fx:id="totalDebts" styleClass="anchor-pane" stylesheets="@../../css/component/anchor-pane.css" VBox.vgrow="ALWAYS">
                                       <children>
                                          <Label fx:id="totalDebtsTitle" styleClass="title" text="%creditCard.totalDebts.title" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="10.0" />
                                          <ComboBox fx:id="totalDebtsYearFilterComboBox" minWidth="150.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0" />
                                          <VBox fx:id="totalDebtsInfoVBox" alignment="CENTER_LEFT" layoutX="5.0" layoutY="50.0" AnchorPane.bottomAnchor="60.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="60.0" />
                                       </children>
                                    </AnchorPane>
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                        <AnchorPane fx:id="barchart" minWidth="700.0" prefWidth="700.0" styleClass="anchor-pane" stylesheets="@../../css/component/anchor-pane.css" HBox.hgrow="ALWAYS">
                           <children>
                              <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                 <children>
                                    <Label fx:id="barchartTitle" styleClass="title" text="%creditCard.debtsFlow.title" />
                                    <AnchorPane fx:id="debtsFlowPane" VBox.vgrow="ALWAYS" />
                                 </children>
                              </VBox>
                           </children>
                        </AnchorPane>
                     </children>
                  </HBox>
               </children>
            </AnchorPane>
            <AnchorPane minHeight="350.0" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <children>
                        <AnchorPane fx:id="debts" styleClass="anchor-pane" stylesheets="@../../css/component/anchor-pane.css" HBox.hgrow="ALWAYS">
                           <children>
                              <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                 <children>
                                    <VBox spacing="10.0">
                                       <children>
                                          <HBox alignment="CENTER_LEFT" spacing="10.0">
                                             <children>
                                                <Label fx:id="expensesTitle" styleClass="title" text="%creditCard.debtsList.title" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <HBox fx:id="debtsFilterGroup" alignment="CENTER_RIGHT" spacing="10.0">
                                                   <children>
                                                      <ComboBox fx:id="debtsListMonthFilterComboBox" minWidth="150.0" />
                                                      <ComboBox fx:id="debtsListYearFilterComboBox" minWidth="150.0" />
                                                   </children>
                                                </HBox>
                                             </children>
                                          </HBox>
                                          <HBox alignment="CENTER_RIGHT" spacing="5.0">
                                             <children>
                                                <FontIcon iconLiteral="mdmz-search" styleClass="app-icon, icon-size-20" />
                                                <TextField fx:id="debtSearchField" promptText="%creditCard.debtsList.searchPlaceholder" />
                                             </children>
                                          </HBox>
                                       </children>
                                    </VBox>
                                    <TableView fx:id="debtsTableView" minWidth="300.0" VBox.vgrow="ALWAYS">
                                       <columnResizePolicy>
                                          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                       </columnResizePolicy>
                                    </TableView>
                                    <HBox alignment="CENTER" spacing="10.0" VBox.vgrow="NEVER">
                                       <children>
                                          <Button styleClass="period-nav" onAction="#handleTablePrevMonth">
                                             <graphic>
                                                <FontIcon iconLiteral="mdal-arrow_back" styleClass="app-icon, icon-size-20" />
                                             </graphic>
                                          </Button>
                                          <Region prefWidth="20.0" />
                                          <Label fx:id="invoiceMonth" alignment="CENTER" prefWidth="60.0" text="MM/YY" textAlignment="CENTER" HBox.hgrow="ALWAYS">
                                             <font>
                                                <Font name="System Bold" size="13.0" />
                                             </font>
                                          </Label>
                                          <Region prefWidth="20.0" />
                                          <Button styleClass="period-nav" onAction="#handleTableNextMonth">
                                             <graphic>
                                                <FontIcon iconLiteral="mdal-arrow_forward" styleClass="app-icon, icon-size-20" />
                                             </graphic>
                                          </Button>
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </children>
                        </AnchorPane>
                        <AnchorPane fx:id="creditCards" styleClass="anchor-pane" stylesheets="@../../css/component/anchor-pane.css">
                           <children>
                              <Label fx:id="creditCardsTitle" styleClass="title" text="%creditCard.creditCards.title" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="10.0" />
                              <Button fx:id="crcPrevButton" AnchorPane.bottomAnchor="10.0" AnchorPane.rightAnchor="60.0">
                                 <graphic>
                                    <FontIcon iconLiteral="mdal-arrow_back" styleClass="app-icon, icon-size-20" />
                                 </graphic>
                              </Button>
                              <Button fx:id="crcNextButton" AnchorPane.bottomAnchor="10.0" AnchorPane.rightAnchor="0.0">
                                 <graphic>
                                    <FontIcon iconLiteral="mdal-arrow_forward" styleClass="app-icon, icon-size-20" />
                                 </graphic>
                              </Button>
                              <HBox alignment="CENTER" fillHeight="false" spacing="10.0" AnchorPane.bottomAnchor="60.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="60.0">
                                 <children>
                                    <AnchorPane fx:id="crcPane1" minHeight="200.0" minWidth="400.0" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                           </children>
                        </AnchorPane>
                     </children>
                  </HBox>
               </children>
            </AnchorPane>
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="4.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</AnchorPane>
