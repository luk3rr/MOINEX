<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moinex.ui.main.SavingsStocksFundsController">
   <children>
      <VBox spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <AnchorPane minHeight="85.0" prefHeight="85.0" styleClass="anchor-pane" stylesheets="@../../css/component/anchor-pane.css" VBox.vgrow="NEVER">
               <children>
                  <HBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <children>
                        <VBox alignment="CENTER" spacing="10.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Text fx:id="stocksFundsNetCapitalLabel" strokeType="OUTSIDE" strokeWidth="0.0" text="%savings.stocksFunds.netCapitalInvested" textAlignment="CENTER">
                                 <font>
                                    <Font size="20.0" />
                                 </font>
                              </Text>
                              <Text fx:id="stocksFundsTabNetCapitalInvestedField" strokeType="OUTSIDE" strokeWidth="0.0" text="\$ 0.00">
                                 <font>
                                    <Font size="17.0" />
                                 </font>
                              </Text>
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" spacing="10.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Text fx:id="stocksFundsCurrentValueLabel" strokeType="OUTSIDE" strokeWidth="0.0" text="%savings.stocksFunds.currentValue" textAlignment="CENTER">
                                 <font>
                                    <Font size="20.0" />
                                 </font>
                              </Text>
                              <Text fx:id="stocksFundsTabCurrentValueField" strokeType="OUTSIDE" strokeWidth="0.0" text="\$ 0.00">
                                 <font>
                                    <Font size="17.0" />
                                 </font>
                              </Text>
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" spacing="10.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Text fx:id="stocksFundsProfitLossLabel" strokeType="OUTSIDE" strokeWidth="0.0" text="%savings.stocksFunds.profitLoss" textAlignment="CENTER">
                                 <font>
                                    <Font size="20.0" />
                                 </font>
                              </Text>
                              <Text fx:id="stocksFundsTabProfitLossField" strokeType="OUTSIDE" strokeWidth="0.0" text="\$ 0.00">
                                 <font>
                                    <Font size="17.0" />
                                 </font>
                              </Text>
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" spacing="10.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Text fx:id="stocksFundsDividendsLabel" strokeType="OUTSIDE" strokeWidth="0.0" text="%savings.stocksFunds.dividendsReceived" textAlignment="CENTER">
                                 <font>
                                    <Font size="20.0" />
                                 </font>
                              </Text>
                              <Text fx:id="stocksFundsTabDividendsReceivedField" strokeType="OUTSIDE" strokeWidth="0.0" text="\$ 0.00">
                                 <font>
                                    <Font size="17.0" />
                                 </font>
                              </Text>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </AnchorPane>
            <AnchorPane styleClass="anchor-pane" stylesheets="@../../css/component/anchor-pane.css" VBox.vgrow="ALWAYS">
               <children>
                  <VBox spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <children>
                        <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                           <children>
                              <Label fx:id="stocksFundsTabBottonPaneTitle" styleClass="title" text="%savings.stocksFunds.portfolio" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Button fx:id="updatePortfolioPricesButton" onAction="#handleUpdatePortfolioPrices" text="%savings.stocksFunds.button.updatePrices">
                                 <graphic>
                                    <FontIcon fx:id="updatePricesButtonIcon" iconLiteral="mdmz-sync" styleClass="app-icon, icon-size-20" />
                                 </graphic>
                              </Button>
                              <HBox fx:id="stocksFundsFilterGroup" alignment="BOTTOM_RIGHT" spacing="10.0">
                                 <children>
                                                         <VBox alignment="CENTER">
                                                            <children>
                                                               <Label text="%savings.stocksFunds.filter.type">
                                                                  <font>
                                                                     <Font size="10.0" />
                                                                  </font>
                                                               </Label>
                                                               <ComboBox fx:id="stocksFundsTabTickerTypeComboBox" minWidth="230.0" prefWidth="230.0" />
                                                            </children>
                                                         </VBox>
                                 </children>
                              </HBox>
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_RIGHT" spacing="5.0">
                           <children>
                                                <FontIcon iconLiteral="mdmz-search" styleClass="app-icon, icon-size-20" />
                                                <TextField fx:id="stocksFundsTabTickerSearchField" prefWidth="300.0" promptText="%savings.stocksFunds.searchPlaceholder" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>
                        <TableView fx:id="stocksFundsTabTickerTable" VBox.vgrow="ALWAYS">
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </AnchorPane>
         </children>
         <padding>
            <Insets top="10.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
