<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane fx:id="rootAnchorPane" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.moinex.ui.main.HomeController">
   <children>
      <VBox fx:id="rootVBox" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <AnchorPane minHeight="300.0">
               <children>
                  <HBox fx:id="rootHBoxUp" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <children>
                        <AnchorPane fx:id="walletPane" minWidth="400.0" styleClass="anchor-pane" stylesheets="@../../css/component/anchor-pane.css" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="walletPaneTitle" styleClass="title" text="%home.wallet.title" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="10.0" />
                              <Button fx:id="walletPrevButton" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="60.0">
                                 <graphic>
                                    <FontIcon iconLiteral="mdal-arrow_back" styleClass="app-icon, icon-size-20" />
                                 </graphic></Button>
                              <Button fx:id="walletNextButton" ellipsisString="" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0">
                                 <graphic>
                                    <FontIcon iconLiteral="mdal-arrow_forward" styleClass="app-icon, icon-size-20" />
                                 </graphic>
                                 <font>
                                    <Font />
                                 </font></Button>
                              <HBox minWidth="260.0" AnchorPane.bottomAnchor="60.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="60.0">
                                 <children>
                                    <AnchorPane fx:id="walletView1" minHeight="125.0" minWidth="120.0" HBox.hgrow="ALWAYS" />
                                    <AnchorPane fx:id="walletView2" minHeight="125.0" minWidth="120.0" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                           </children>
                        </AnchorPane>
                        <AnchorPane fx:id="creditCardPane" minWidth="400.0" styleClass="anchor-pane" stylesheets="@../../css/component/anchor-pane.css" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="creditCardPaneTitle" styleClass="title" text="%home.creditCard.title" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="10.0" />
                              <Button fx:id="creditCardPrevButton" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="60.0">
                                 <graphic>
                                    <FontIcon iconLiteral="mdal-arrow_back" styleClass="app-icon, icon-size-20" />
                                 </graphic></Button>
                              <Button fx:id="creditCardNextButton" graphicTextGap="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0">
                                 <graphic>
                                    <FontIcon iconLiteral="mdal-arrow_forward" styleClass="app-icon, icon-size-20" />
                                 </graphic></Button>
                              <HBox layoutX="108.0" minWidth="260.0" AnchorPane.bottomAnchor="60.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="60.0">
                                 <children>
                                    <AnchorPane fx:id="creditCardView1" minHeight="125.0" minWidth="120.0" HBox.hgrow="ALWAYS" />
                                    <AnchorPane fx:id="creditCardView2" minHeight="125.0" minWidth="120.0" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                           </children>
                        </AnchorPane>
                        <AnchorPane fx:id="monthResumePane" maxWidth="500.0" minWidth="300.0" styleClass="anchor-pane" stylesheets="@../../css/component/anchor-pane.css" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="monthResumePaneTitle" styleClass="title" text="Resume" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="10.0" />
                              <AnchorPane fx:id="monthResumeView" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="50.0" />
                           </children>
                        </AnchorPane>
                     </children>
                  </HBox>
               </children>
            </AnchorPane>
            <AnchorPane minHeight="400.0" VBox.vgrow="ALWAYS">
               <children>
                  <HBox fx:id="rootHBoxBottom" maxWidth="1.7976931348623157E308" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <children>
                        <AnchorPane fx:id="graphPane" minWidth="800.0" prefWidth="800.0" styleClass="anchor-pane" stylesheets="@../../css/component/anchor-pane.css" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="graphTitle" layoutX="32.0" layoutY="10.0" styleClass="title" text="%home.moneyFlow.title" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="10.0" />
                              <HBox spacing="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                                 <children>
                                    <ComboBox fx:id="sankeyMonthComboBox" minWidth="150.0" />
                                    <ComboBox fx:id="sankeyYearComboBox" minWidth="80.0" />
                                 </children>
                              </HBox>
                              <Button fx:id="recalculateNetWorthButton" onAction="#handleRecalculateNetWorth" styleClass="button-primary" text="%home.recalculateNetWorthButton" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                                 <graphic>
                                    <FontIcon fx:id="recalculateNetWorthButtonIcon" iconLiteral="mdmz-refresh" styleClass="app-icon, icon-size-20" />
                                 </graphic>
                              </Button>
                              <HBox fx:id="sankeyNavigator" alignment="CENTER" layoutX="10.0" layoutY="10.0" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">
                                 <children>
                                    <Button onAction="#handleSankeyPrevMonth">
                                       <graphic>
                                          <FontIcon iconLiteral="mdal-arrow_back" styleClass="app-icon, icon-size-20" />
                                       </graphic>
                                    </Button>
                                    <Region prefWidth="20.0" />
                                    <Label fx:id="sankeyMonth" alignment="CENTER" prefWidth="60.0" text="MM/YY" textAlignment="CENTER" HBox.hgrow="ALWAYS">
                                       <font>
                                          <Font name="System Bold" size="13.0" />
                                       </font>
                                    </Label>
                                    <Region prefWidth="20.0" />
                                    <Button onAction="#handleSankeyNextMonth">
                                       <graphic>
                                          <FontIcon iconLiteral="mdal-arrow_forward" styleClass="app-icon, icon-size-20" />
                                       </graphic>
                                    </Button>
                                 </children>
                              </HBox>
                              <Button fx:id="graphPrevButton" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="60.0">
                                 <graphic>
                                    <FontIcon iconLiteral="mdal-arrow_back" styleClass="app-icon, icon-size-20" />
                                 </graphic>
                              </Button>
                              <Button fx:id="graphNextButton" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0">
                                 <graphic>
                                    <FontIcon iconLiteral="mdal-arrow_forward" styleClass="app-icon, icon-size-20" />
                                 </graphic>
                              </Button>
                              <AnchorPane fx:id="graphView" minWidth="300.0" AnchorPane.bottomAnchor="60.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="60.0" />
                           </children>
                        </AnchorPane>
                        <AnchorPane fx:id="lastTransactionsPane" maxWidth="500.0" minWidth="500.0" styleClass="anchor-pane" stylesheets="@../../css/component/anchor-pane.css" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="lastTransactionsPaneTitle" layoutX="10.0" layoutY="17.0" styleClass="title" text="%home.transactions.title" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="10.0" />
                              <TableView fx:id="transactionsTableView" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="60.0">
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                           </children>
                        </AnchorPane>
                     </children>
                  </HBox>
               </children>
            </AnchorPane>
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</AnchorPane>
